# ChanceNear. Everything is optional: with nothing set, the judge runs on deterministic rules, token data comes from
# the bundled snapshot of GET /v1/tokens, and records go to .data/chancenear.json.

# NEAR AI Cloud (https://cloud.near.ai): the TEE-hosted judge model, and the model that plays the agent in live rehearsals.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_AGENT_MODEL=Qwen/Qwen3.8-27B

# NEAR Intents Agent API (https://partners.near-intents.org): dry-run quotes and live execution.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
# Set after creating the agent (Connect page or `npm run near:setup`): its id and the owner-signed grant token.
NEAR_INTENTS_AGENT_ID=
NEAR_INTENTS_GRANT_TOKEN=

# Postgres (Railway). Without it, records live in CHANCENEAR_DATA_DIR.
DATABASE_URL=
CHANCENEAR_DATA_DIR=.data

# Bearer token for POST /api/v1/execute (live execution). Without it, execution is off.
CHANCENEAR_ADMIN_TOKEN=
